# Teranga GP - Environment Configuration
# Copy this file to .env.local and fill in your actual values
# DO NOT commit this file to Git - it contains secrets!

# Supabase Configuration
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Netlify Configuration
# Get this from your Netlify site settings
NETLIFY_SITE_URL=https://your-site.netlify.app

# Optional: Service Role Key (for server-side operations only)
# WARNING: Never expose this to the browser!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
